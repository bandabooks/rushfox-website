---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import PostCard from '../../components/PostCard.astro';
import { render } from 'astro:content';
import { publishedInsights, slugify } from '../../lib/insights';

export async function getStaticPaths() {
  const posts = await publishedInsights();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, related: posts.filter((p) => p.id !== post.id && p.data.category === post.data.category).slice(0, 3) } }));
}
const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data.date.toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' });
const ld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), author: { '@type': 'Organization', name: post.data.author }, publisher: { '@type': 'Organization', name: 'Rush Fox Security and CCTV (Pty) Ltd' } };
---
<Base title={post.data.title} description={post.data.description} type="article" crumbs={[{ name: 'Insights', href: '/insights/' }, { name: post.data.title, href: `/insights/${post.id}/` }]}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHead kicker="Insights" title={post.data.title} text={post.data.description} />
  <article class="article">
    <div class="post-meta" style="margin-bottom:28px"><a class="tag" href={`/insights/category/${slugify(post.data.category)}`} style="text-decoration:none">{post.data.category}</a><span>{d}</span><span>· {post.data.author}</span>{post.data.readingMinutes && <span>· {post.data.readingMinutes} min read</span>}</div>
    <Content />
    <div class="article-cta"><CtaBand /></div>
  </article>
  {related.length > 0 && (
    <section class="sec tint"><div class="wrap"><h2>Related insights</h2><div class="posts" style="margin-top:20px">{related.map((p) => <PostCard post={p} />)}</div></div></section>
  )}
</Base>
