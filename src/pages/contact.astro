---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import Combo from '../components/Combo.astro';
import { company, tel, manned, tech, consulting } from '../data/company';
import { places, provinces } from '../data/places';
const services = ['General enquiry', 'Integrated security solution', ...manned.map((s) => s.title), ...tech.map((s) => s.title), ...consulting.map((s) => s.title)];
---
<Base title="Contact" description="Contact Rush Fox Security in Mokopane, Limpopo for a free site risk assessment and quotation for guarding, CCTV, access control or alarms.">
  <PageHead kicker="Contact" title="Let's secure your site" text="Request a free site risk assessment and quotation for guarding, CCTV, access control or a fully integrated security solution." />

  <section class="sec">
    <div class="wrap contact-grid">
      <div class="cbox">
        <h3>Talk to us directly</h3>
        <ul>
          {company.phones.map((p) => <li><Icon name="phone" size={20} /><a href={tel(p)}>{p}</a></li>)}
          {company.whatsapp && <li><Icon name="whatsapp" size={20} /><a href={`https://wa.me/${company.whatsapp}`} rel="noopener" target="_blank">WhatsApp: {company.whatsappDisplay}</a></li>}
          {company.emails.map((e) => <li><Icon name="mail" size={20} /><span><small style="display:block;color:#AFC3DB">{e.label}</small><a href={`mailto:${e.address}`}>{e.address}</a></span></li>)}
          <li><Icon name="pin" size={20} /><a href={company.address.mapsUrl} rel="noopener" target="_blank">{company.address.line1}<br />{company.address.city}, {company.address.province}, {company.address.postalCode}</a></li>
          <li><Icon name="doc" size={20} /><span>{company.address.postal}</span></li>
        </ul>
        <hr style="border:0;border-top:1px solid rgba(255,255,255,.15);margin:22px 0" />
        <p style="font-size:.9rem;margin:0">{company.legalName}<br />Reg. {company.registrations.cipc} · PSiRA {company.registrations.psira}</p>
      </div>

      <form class="quote" id="quote" aria-labelledby="qh">
        <h2 id="qh" style="font-size:1.6rem">Request a quote</h2>
        <p class="small">Complete the form and press send. Your email app opens with the details filled in, ready to send to {company.email}.</p>
        <div class="fg">
          <div class="field"><label for="name">Full name *</label><input id="name" name="name" required autocomplete="name" /></div>
          <div class="field"><label for="org">Company / organisation</label><input id="org" name="org" autocomplete="organization" /></div>
          <div class="field"><label for="phone">Phone *</label><input id="phone" name="phone" type="tel" required autocomplete="tel" /></div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" /></div>
        </div>
        <Combo id="service" label="How can we help?" options={services} placeholder="Search services…" value="General enquiry" />
        <div class="fg">
          <Combo id="province" label="Province" options={provinces} placeholder="Select your province" required />
          <Combo id="town" label="Town / suburb" options={[]} placeholder="Select a province first" required freeText disabled />
        </div>
        <div class="field"><label for="street">Street address (optional)</label><input id="street" name="street" autocomplete="street-address" placeholder="Site street address" /></div>
        <div class="field"><label for="msg">Tell us about your site</label><textarea id="msg" name="msg" rows="5" placeholder="Type of premises, number of entrances, hours of cover needed, existing systems..."></textarea></div>
        <div class="field" style="display:flex;gap:10px;align-items:flex-start"><input type="checkbox" id="consent" required style="width:auto;margin-top:5px" /><label for="consent" style="font-weight:400">I agree that Rush Fox Security may use these details to respond to my enquiry, as set out in the <a href="/privacy">privacy notice</a>. *</label></div>
        <button class="btn btn-amber" type="submit">Send enquiry <Icon name="arrow" size={18} /></button>
      </form>
    </div>
  </section>
</Base>

<script define:vars={{ to: company.email, places }}>
  // ---------- searchable dropdowns ----------
  const combos = {};
  document.querySelectorAll('[data-combo]').forEach((root) => {
    const input = root.querySelector('input');
    const list = root.querySelector('.combo-list');
    const btn = root.querySelector('.combo-toggle');
    const free = root.dataset.free === '1';
    let opts = JSON.parse(list.dataset.options || '[]');
    let active = -1;
    const norm = (t) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const render = (showAll) => {
      const q = showAll ? '' : norm(input.value.trim());
      const hits = opts.filter((o) => norm(o).includes(q));
      list.innerHTML = '';
      hits.forEach((o, i) => {
        const li = document.createElement('li');
        li.role = 'option'; li.textContent = o; li.id = `${input.id}-opt-${i}`;
        if (o === input.value) li.setAttribute('aria-selected', 'true');
        li.addEventListener('mousedown', (e) => { e.preventDefault(); choose(o); });
        list.appendChild(li);
      });
      if (!hits.length) {
        const li = document.createElement('li');
        li.className = 'combo-empty';
        li.textContent = free && input.value.trim() ? `Use "${input.value.trim()}"` : 'No match';
        if (free && input.value.trim()) li.addEventListener('mousedown', (e) => { e.preventDefault(); close(); });
        list.appendChild(li);
      }
      active = -1; open();
    };
    const open = () => { list.hidden = false; input.setAttribute('aria-expanded', 'true'); };
    const close = () => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); };
    const choose = (o) => { input.value = o; input.setCustomValidity(''); close(); input.dispatchEvent(new CustomEvent('combo:change', { detail: o })); };
    const move = (d) => {
      const items = [...list.querySelectorAll('[role=option]')];
      if (!items.length) return;
      active = (active + d + items.length) % items.length;
      items.forEach((li, i) => li.classList.toggle('on', i === active));
      items[active].scrollIntoView({ block: 'nearest' });
      input.setAttribute('aria-activedescendant', items[active].id);
    };
    input.addEventListener('focus', () => render(true));
    input.addEventListener('click', () => render(true));
    input.addEventListener('input', () => render(false));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); list.hidden ? render(true) : move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter' && !list.hidden) {
        const items = list.querySelectorAll('[role=option]');
        if (active >= 0 && items[active]) { e.preventDefault(); choose(items[active].textContent); }
        else if (items.length === 1) { e.preventDefault(); choose(items[0].textContent); }
        else close();
      } else if (e.key === 'Escape') close();
    });
    input.addEventListener('blur', () => {
      setTimeout(close, 120);
      const exact = opts.find((o) => norm(o) === norm(input.value.trim()));
      if (exact) { input.value = exact; input.dispatchEvent(new CustomEvent('combo:change', { detail: exact })); }
      else if (!free && input.value.trim()) input.setCustomValidity('Please choose an option from the list.');
      else input.setCustomValidity('');
    });
    btn.addEventListener('mousedown', (e) => { e.preventDefault(); if (input.disabled) return; list.hidden ? (input.focus(), render(true)) : close(); });
    combos[input.id] = { input, setOptions: (o) => { opts = o; } };
  });

  // Town list follows the province
  const prov = combos.province, town = combos.town;
  prov.input.addEventListener('combo:change', (e) => {
    const list = places[e.detail] || [];
    town.setOptions(list);
    town.input.disabled = false;
    town.input.value = '';
    town.input.placeholder = list.length ? 'Search or type your town / suburb' : 'Type your town and country';
  });

  // ---------- send ----------
  const f = document.getElementById('quote');
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!f.reportValidity()) return;
    const v = (id) => (document.getElementById(id).value || '').trim();
    const subject = `Quote request: ${v('service')} - ${v('org') || v('name')} (${v('town')}, ${v('province')})`;
    const body = [
      `Name: ${v('name')}`, `Company: ${v('org')}`, `Phone: ${v('phone')}`, `Email: ${v('email')}`,
      `Service: ${v('service')}`, `Province: ${v('province')}`, `Town / suburb: ${v('town')}`, `Street address: ${v('street')}`, '', v('msg'),
    ].join('\n');
    window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
