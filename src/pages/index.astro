---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { company, manned, tech, why, sectors, steps } from '../data/company';

const posts = (await getCollection('insights', ({ data }) => !data.draft && data.date <= new Date()))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const featured = [manned[0], manned[1], tech[0], tech[3], tech[6], tech[7]];
---
<Base title="Home" description="Rush Fox Security: PSiRA-registered manned guarding, CCTV surveillance, access control, alarms and electric fencing in Mokopane, Polokwane and Limpopo. B-BBEE Level 1, CSD registered.">
  <section class="hero">
    <div class="wrap hero-in">
      <div>
        <div class="eyebrow">Mokopane · Polokwane · Limpopo</div>
        <h1>Integrated Security.<br /><span>Trusted Protection.</span></h1>
        <p class="lead">PSiRA-registered manned guarding combined with CCTV surveillance, access control, alarm and perimeter technology for business, government and residential clients across South Africa.</p>
        <div class="hero-cta">
          <a class="btn btn-amber" href="/contact#quote">Request a Free Site Assessment <Icon name="arrow" size={18} /></a>
          <a class="btn btn-ghost" href="/services">Our Services</a>
        </div>
        <div class="badges">
          <div><b>PSiRA</b><span>Reg. {company.registrations.psira}</span></div>
          <div><b>B-BBEE</b><span>{company.registrations.bbbee}</span></div>
          <div><b>CSD</b><span>{company.registrations.csd}</span></div>
          <div><b>CIDB</b><span>{company.registrations.cidbGrade}</span></div>
        </div>
      </div>
      <img class="hero-emblem" src="/brand/icon.svg" alt="" width="380" height="418" />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="kicker">What we do</div>
      <h2>Guarding and technology from one accountable provider</h2>
      <p class="intro">Officers protect, technology detects and our team responds. Every site gets disciplined, PSiRA-registered security officers and the electronic systems to watch, record and control access.</p>
      <div class="grid g3">
        {featured.map((s) => (
          <div class="card"><div class="ci"><Icon name={s.icon} /></div><div><h3>{s.title}</h3><p>{s.text}</p></div></div>
        ))}
      </div>
      <p style="margin-top:28px"><a class="btn btn-navy" href="/services">View all services <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="kicker">Why choose Rush Fox</div>
      <h2>Six reasons clients trust us</h2>
      <div class="grid g3" style="margin-top:28px">
        {why.map((w) => (
          <div class="why"><div class="wi"><Icon name={w.icon} /></div><h3>{w.title}</h3><p>{w.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div>
        <div class="kicker">On the ground</div>
        <h2>Visible, branded and on the move</h2>
        <p class="intro" style="margin-bottom:24px">Our branded supervision and patrol vehicles operate daily across Mokopane and Polokwane, carrying supervisors to sites, supporting shift changes and responding to incidents. Vehicles are fitted with GPS tracking.</p>
        <div class="stats">
          <div><b>Mokopane</b>Head office</div>
          <div><b>Polokwane</b>Active sites</div>
          <div><b>GPS-tracked</b>Vehicles</div>
          <div><b>Day & night</b>Shifts</div>
        </div>
      </div>
      <figure class="photo" style="margin:0"><img src="/img/fleet1.jpg" alt="Rush Fox branded supervision vehicle in Mokopane" width="1200" height="800" loading="lazy" /></figure>
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap">
      <div class="kicker">How we work</div>
      <h2>Our five-step approach</h2>
      <div class="grid g5" style="margin-top:28px">
        {steps.map((s, i) => (
          <div class="step" style="color:var(--ink)"><div class="n">{i + 1}</div><h3>{s.title}</h3><p>{s.text}</p></div>
        ))}
      </div>
      <h3 style="margin-top:48px">Sectors we serve</h3>
      <div class="chips">{sectors.map((s) => <span>{s}</span>)}</div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="kicker">Insights</div>
        <h2>Security advice and company news</h2>
        <p class="intro">Practical guidance on guarding, CCTV, access control and keeping your business secure.</p>
        <div class="posts">{posts.map((p) => <PostCard post={p} />)}</div>
        <p style="margin-top:28px"><a class="btn btn-navy" href="/insights">All insights <Icon name="arrow" size={18} /></a></p>
      </div>
    </section>
  )}

  <section class="sec tint"><div class="wrap"><CtaBand /></div></section>
</Base>
